// =====================================================
// NEW: SMOOTHED BATTERY READING
// =====================================================

void updateBatteryReading(bool force = false) {

 unsigned long now = millis();

 // Update every 3 seconds

 if (
 !force &&
 now - lastBatteryUpdate < BATTERY_UPDATE_MS
 ) {
 return;
 }

 lastBatteryUpdate = now;

 // ==========================================
 // STEP 1: Read 64 ADC samples
 // ==========================================

 // Discard the first reading.

 analogReadMilliVolts(BATTERY_ADC_PIN);

 uint32_t totalMilliVolts = 0;

 for (int i = 0; i < BATTERY_SAMPLES; i++) {

 totalMilliVolts +=
 analogReadMilliVolts(BATTERY_ADC_PIN);

 delayMicroseconds(200);
 }

 float gpioVoltage =
 (totalMilliVolts / (float)BATTERY_SAMPLES)
 / 1000.0f;

 // ==========================================
 // STEP 2: Calculate battery voltage
 // ==========================================

 float rawBatteryVoltage =
 gpioVoltage *
 ((BATTERY_R1 + BATTERY_R2) / BATTERY_R2);

 // ==========================================
 // STEP 3: Exponential smoothing
 // ==========================================

 if (!batteryFilterInitialized) {

 smoothedBatteryVoltage =
 rawBatteryVoltage;

 batteryFilterInitialized = true;

 } else {

 smoothedBatteryVoltage =
 BATTERY_ALPHA * rawBatteryVoltage +
 (1.0f - BATTERY_ALPHA) *
 smoothedBatteryVoltage;
 }

 batteryVoltage = smoothedBatteryVoltage;

 // ==========================================
 // STEP 4: Convert voltage to percentage
 // ==========================================

 int targetPercentage = -1;

 if (batteryVoltage >= 2.5f) {

 targetPercentage =
 voltageToPercentage(batteryVoltage);
 }

 // ==========================================
 // STEP 5: Limit percentage change
 // ==========================================

 if (targetPercentage < 0) {

 batteryPercentage = -1;

 } else if (batteryPercentage < 0) {

 // Initial reading

 batteryPercentage = targetPercentage;

 } else if (targetPercentage > batteryPercentage) {

 // Increase by maximum 1%

 batteryPercentage++;

 } else if (targetPercentage < batteryPercentage) {

 // Decrease by maximum 1%

 batteryPercentage--;
 }

 // ==========================================
 // STEP 6: Debug output
 // ==========================================

 Serial.print("Battery raw: ");
 Serial.print(rawBatteryVoltage, 3);

 Serial.print(" V | Smoothed: ");
 Serial.print(batteryVoltage, 3);

 Serial.print(" V | Percentage: ");
 Serial.print(batteryPercentage);
 Serial.println("%");

 // ==========================================
 // STEP 7: Update TFT
 // ==========================================

 drawBatteryIndicator();
}

