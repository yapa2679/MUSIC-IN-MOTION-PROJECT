// =====================================================
// BATTERY PERCENTAGE ESTIMATION
// =====================================================

int voltageToPercentage(float voltage) {

 const float voltages[] = {
 3.30, 3.50, 3.60, 3.70, 3.75,
 3.80, 3.85, 3.90, 4.00, 4.10, 4.20
 };

 const int percentages[] = {
 0, 5, 10, 20, 30,
 40, 50, 60, 75, 90, 100
 };

 if (voltage <= voltages[0]) return 0;
 if (voltage >= voltages[10]) return 100;

 for (int i = 1; i < 11; i++) {

 if (voltage <= voltages[i]) {

 float fraction =
 (voltage - voltages[i - 1]) /
 (voltages[i] - voltages[i - 1]);

 return percentages[i - 1] +
 roundf(
 fraction *
 (percentages[i] - percentages[i - 1])
 );
 }
 }

 return 100;
}

