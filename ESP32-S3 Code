// =====================================================
// PERFORM MEDIA ACTION
// =====================================================

void performAction(
 int action,
 const char* source
) {

 if (action == ACTION_NONE) {
 return;
 }

 // Ignore commands during cooldown.

 if (commandCooldownActive()) {
 return;
 }

 if (!bleKeyboard.isConnected()) {

 Serial.println(
 "Bluetooth not connected. Command ignored."
 );

 return;
 }

 Serial.print(source);
 Serial.print(": ");

 switch (action) {

 case ACTION_PLAY_PAUSE:

 Serial.println("PLAY / PAUSE");

 bleKeyboard.write(
 KEY_MEDIA_PLAY_PAUSE
 );

 break;

 case ACTION_NEXT:

 Serial.println("NEXT");

 bleKeyboard.write(
 KEY_MEDIA_NEXT_TRACK
 );

 break;

 case ACTION_PREVIOUS:

 Serial.println("PREVIOUS");

 bleKeyboard.write(
 KEY_MEDIA_PREVIOUS_TRACK
 );

 break;

 case ACTION_VOLUME_UP:

 Serial.println("VOLUME UP");

 bleKeyboard.write(
 KEY_MEDIA_VOLUME_UP
 );

 delay(60);

 bleKeyboard.write(
 KEY_MEDIA_VOLUME_UP
 );

 break;

 case ACTION_VOLUME_DOWN:

 Serial.println("VOLUME DOWN");

 bleKeyboard.write(
 KEY_MEDIA_VOLUME_DOWN
 );

 delay(60);

 bleKeyboard.write(
 KEY_MEDIA_VOLUME_DOWN
 );

 break;

 case ACTION_MUTE:

 Serial.println("MUTE");

 bleKeyboard.write(
 KEY_MEDIA_MUTE
 );

 break;

 default:

 return;
 }

 startCommandCooldown();

 Serial.println("Command cooldown: 2 seconds");
}

