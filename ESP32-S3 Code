// =====================================================
// BLUETOOTH METADATA CALLBACK
// =====================================================

class MetadataCallbacks :
 public NimBLECharacteristicCallbacks {

 void onWrite(
 NimBLECharacteristic* characteristic,
 NimBLEConnInfo& connInfo
 ) override {

 std::string raw = characteristic->getValue();

 String message = "";

 message.reserve(raw.size());

 for (char c : raw) {
 message += c;
 }

 // ARTWORK START

 if (message.startsWith("ARTSTART:")) {

 artBytesReceived = 0;
 receivingArt = true;
 artworkReady = false;

 int expected = message.substring(9).toInt();

 Serial.print("Artwork transfer starting: ");
 Serial.println(expected);

 return;
 }

 // ARTWORK END

 if (message == "ARTEND") {

 receivingArt = false;

 Serial.print("Artwork bytes received: ");
 Serial.println(artBytesReceived);

 if (artBytesReceived == ART_BYTES) {

 artworkReady = true;
 screenUpdate = true;

 Serial.println("ALBUM ART READY!");

 } else {

 Serial.println("Artwork size incorrect.");
 }

 return;
 }

 // TRACK AND ARTIST

 int artistPosition = message.indexOf("\nARTIST:");

 if (
 message.startsWith("TRACK:") &&
 artistPosition >= 0
 ) {

 currentTrack =
 message.substring(6, artistPosition);

 currentArtist =
 message.substring(artistPosition + 8);

 currentTrack.trim();
 currentArtist.trim();

 if (currentTrack.length() == 0) {
 currentTrack = "Unknown Track";
 }

 if (currentArtist.length() == 0) {
 currentArtist = "Unknown Artist";
 }

 Serial.println();
 Serial.println("NEW SONG");

 Serial.print("Track: ");
 Serial.println(currentTrack);

 Serial.print("Artist: ");
 Serial.println(currentArtist);

 screenUpdate = true;
 }
 }
};

// =====================================================
// ARTWORK CALLBACK
// =====================================================

class ArtworkCallbacks :
 public NimBLECharacteristicCallbacks {

 void onWrite(
 NimBLECharacteristic* characteristic,
 NimBLEConnInfo& connInfo
 ) override {

 if (!receivingArt || artwork == nullptr) {
 return;
 }

 std::string data = characteristic->getValue();

 size_t remaining =
 ART_BYTES - artBytesReceived;

 size_t amount = data.size();

 if (amount > remaining) {
 amount = remaining;
 }

 memcpy(
 ((uint8_t*)artwork) + artBytesReceived,
 data.data(),
 amount
 );

 artBytesReceived += amount;
 }
};

MetadataCallbacks metadataCallbacks;
ArtworkCallbacks artworkCallbacks;

// =====================================================
// CUSTOM BLE KEYBOARD
// =====================================================

class GestureMusicKeyboard : public BleKeyboard {

public:

 GestureMusicKeyboard(
 std::string name,
 std::string manufacturer,
 uint8_t battery
 )
 :
 BleKeyboard(name, manufacturer, battery) {}

protected:

 void onStarted(NimBLEServer* server) override {

 NimBLEService* service =
 server->createService(SERVICE_UUID);

 NimBLECharacteristic* metadata =
 service->createCharacteristic(
 META_UUID,
 NIMBLE_PROPERTY::WRITE |
 NIMBLE_PROPERTY::WRITE_NR
 );

 metadata->setCallbacks(&metadataCallbacks);

 NimBLECharacteristic* art =
 service->createCharacteristic(
 ART_UUID,
 NIMBLE_PROPERTY::WRITE |
 NIMBLE_PROPERTY::WRITE_NR
 );

 art->setCallbacks(&artworkCallbacks);

 service->start();

 Serial.println(
 "GestureMusic metadata service ready."
 );
 }

 void onConnect(
 NimBLEServer* server,
 NimBLEConnInfo& connInfo
 ) override {

 BleKeyboard::onConnect(server, connInfo);

 Serial.println("Bluetooth connected.");

 NimBLEDevice::getAdvertising()->start();
 }

 void onDisconnect(
 NimBLEServer* server,
 NimBLEConnInfo& connInfo,
 int reason
 ) override {

 BleKeyboard::onDisconnect(
 server,
 connInfo,
 reason
 );

 Serial.println("Bluetooth disconnected.");

 NimBLEDevice::getAdvertising()->start();
 }
};

