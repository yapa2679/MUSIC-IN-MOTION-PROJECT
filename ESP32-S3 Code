// =====================================================
// 2 SECOND COMMAND COOLDOWN
// =====================================================

const unsigned long COMMAND_COOLDOWN_MS = 2000;

unsigned long lastCommandTime = 0;
bool commandPreviouslyExecuted = false;

bool commandCooldownActive() {

 if (!commandPreviouslyExecuted) {
 return false;
 }

 return millis() - lastCommandTime <
 COMMAND_COOLDOWN_MS;
}

void startCommandCooldown() {

 lastCommandTime = millis();
 commandPreviouslyExecuted = true;
}

