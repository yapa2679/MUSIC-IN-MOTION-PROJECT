// =====================================================
// MAIN LOOP
// =====================================================

void loop() {

 static bool oldBluetoothState = false;

 // =================================================
 // BATTERY MONITORING
 // =================================================

 updateBatteryReading();

 // =================================================
 // COMMAND COOLDOWN
 // =================================================

 if (commandCooldownActive()) {

 detectedVoiceCommand = -1;
 wakeDetected = false;
 }

 // =================================================
 // BLUETOOTH CONNECTION STATUS
 // =================================================

 bool connected =
 bleKeyboard.isConnected();

 if (connected != oldBluetoothState) {

 oldBluetoothState = connected;

 drawHeader();
 drawStatus();

 if (connected) {

 Serial.println(
 "GestureMusic connected."
 );

 } else {

 Serial.println(
 "GestureMusic disconnected."
 );
 }
 }

 // =================================================
 // DISPLAY UPDATE
 // =================================================

 if (screenUpdate) {

 screenUpdate = false;

 drawArtworkCard();
 drawAlbumArtwork();
 drawTrackInfo();
 }

 // =================================================
 // GESTURES
 // =================================================

 checkGestures();

 // =================================================
 // SOUND MODE
 // =================================================

 if (soundMode) {

 checkSharpSounds();
 }

 // =================================================
 // VOICE WAKEWORD
 // =====================================================

 if (
 !soundMode &&
 !commandCooldownActive() &&
 wakeDetected
 ) {

 wakeDetected = false;

 Serial.println();
 Serial.println(">>> HI ESP DETECTED <<<");
 Serial.println("Listening...");

 drawStatus("LISTENING...");
 }

 // =================================================
 // VOICE COMMAND
 // =====================================================

 if (
 !soundMode &&
 !commandCooldownActive() &&
 detectedVoiceCommand >= 0
 ) {

 int command =
 detectedVoiceCommand;

 detectedVoiceCommand = -1;

 handleVoiceCommand(command);

 drawStatus("VOICE COMMAND");

 delay(250);

 drawStatus();
 }

 // =================================================
 // VOICE TIMEOUT
 // =====================================================

 if (
 !soundMode &&
 timeoutDetected
 ) {

 timeoutDetected = false;

 Serial.println(
 "Voice command timeout."
 );

 drawStatus();
 }

 delay(5);
}
