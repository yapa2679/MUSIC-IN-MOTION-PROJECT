}

// =====================================================
// DISABLE SOUND MODE
// =====================================================

void disableSoundMode() {

 if (!soundMode) return;

 soundMode = false;

 sharpSoundCount = 0;
 lastSharpSound = 0;
 firstSharpSound = 0;

 if (voiceReady) {

 ESP_SR.resume();

 delay(40);
 }

 Serial.println();
 Serial.println("SOUND MODE OFF");

 Serial.println("Voice recognition resumed.");

 drawStatus();
}

// =====================================================
// TOGGLE SOUND MODE
// =====================================================

void toggleSoundMode() {

 if (commandCooldownActive()) {
 return;
 }

 detectedVoiceCommand = -1;
 wakeDetected = false;
 timeoutDetected = false;

 if (soundMode) {

 disableSoundMode();

 } else {

 enableSoundMode();
 }

 startCommandCooldown();
}

// =====================================================
// EXECUTE SOUND PATTERN
// =====================================================

void executeSharpSoundPattern() {

 if (sharpSoundCount <= 0) return;

 int count = sharpSoundCount;

 sharpSoundCount = 0;
 firstSharpSound = 0;
 lastSharpSound = 0;

 if (commandCooldownActive()) {
 return;
 }

 Serial.print("Sharp sound pattern: ");
 Serial.println(count);

 if (count == 1) {

 performAction(
 ACTION_PLAY_PAUSE,
 "SOUND"
 );

 drawStatus("1 SOUND: PLAY");

 } else if (count == 2) {

 performAction(
 ACTION_NEXT,
 "SOUND"
 );

 drawStatus("2 SOUNDS: NEXT");

 } else {

 performAction(
 ACTION_PREVIOUS,
 "SOUND"
 );

 drawStatus("3 SOUNDS: PREV");
 }

 delay(250);

 drawStatus("SOUND MODE");
}

// =====================================================
// SHARP SOUND DETECTION
// =====================================================

void checkSharpSounds() {

 if (!soundMode) return;

 int16_t samples[128];

 size_t bytesRead =
 i2s.readBytes(
 (char*)samples,
 sizeof(samples)
 );

 int count =
 bytesRead / sizeof(int16_t);

 if (count <= 0) return;

 // Discard sound activity during cooldown.

 if (commandCooldownActive()) {

 sharpSoundCount = 0;
 lastSharpSound = 0;
 firstSharpSound = 0;

 return;
 }

 long peak = 0;

 for (int i = 0; i < count; i++) {

 long magnitude =
 abs((long)samples[i]);

 if (magnitude > peak) {
 peak = magnitude;
 }
 }

 unsigned long now = millis();

 if (peak >= SHARP_SOUND_THRESHOLD) {

 if (
 lastSharpSound == 0 ||
 now - lastSharpSound >=
 SHARP_SOUND_DEBOUNCE_MS
 ) {

 sharpSoundCount++;

 if (sharpSoundCount == 1) {
 firstSharpSound = now;
 }

 lastSharpSound = now;

 Serial.print("SHARP SOUND! Peak = ");
 Serial.print(peak);

 Serial.print(" | Count = ");
 Serial.println(sharpSoundCount);

 if (sharpSoundCount == 1) {

 drawStatus("SOUND 1");

 } else if (sharpSoundCount == 2) {

 drawStatus("SOUND 2");

 } else {

 drawStatus("SOUND 3");
 }
 }
 }

 if (
 sharpSoundCount > 0 &&
 lastSharpSound > 0 &&
 now - lastSharpSound >=
 SHARP_SOUND_GROUP_MS
 ) {

 executeSharpSoundPattern();
 }
}

// =====================================================
// GESTURE RECOGNITION
// =====================================================

// RIGHT -> Next
// LEFT -> Previous
// FORWARD -> Play/Pause
// UP -> Volume Up
// DOWN -> Volume Down
// WAVE -> Mute
// BACKWARD -> Toggle Sound Mode

void checkGestures() {

 if (!gestureReady) return;

 Gesture gesture =
 gestureSensor.readGesture();

 if (gesture == GES_NONE) return;

 // Discard gestures during cooldown.

 if (commandCooldownActive()) {
 return;
 }

 if (
 millis() - lastGesture <
 GESTURE_COOLDOWN_MS
 ) {
 return;
 }

 if (gesture == GES_BACKWARD) {

 lastGesture = millis();

 toggleSoundMode();

 return;
 }

 int action = ACTION_NONE;

 switch (gesture) {

 case GES_RIGHT:

 action = ACTION_NEXT;
 break;

 case GES_LEFT:

 action = ACTION_PREVIOUS;
 break;

 case GES_FORWARD:

 action = ACTION_PLAY_PAUSE;
 break;

 case GES_UP:

 action = ACTION_VOLUME_UP;
 break;

 case GES_DOWN:

 action = ACTION_VOLUME_DOWN;
 break;

 case GES_WAVE:

 action = ACTION_MUTE;
 break;

 default:

 break;
 }

 if (action != ACTION_NONE) {

 lastGesture = millis();

 performAction(
 action,
 "GESTURE"
 );
 }
}

