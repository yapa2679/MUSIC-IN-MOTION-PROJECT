 int command_id,
 int phrase_id
) {

 switch (event) {

 case SR_EVENT_WAKEWORD:

 if (
 !soundMode &&
 !commandCooldownActive()
 ) {

 wakeDetected = true;

 ESP_SR.setMode(SR_MODE_COMMAND);
 }

 break;

 case SR_EVENT_WAKEWORD_CHANNEL:

 if (
 !soundMode &&
 !commandCooldownActive()
 ) {

 wakeDetected = true;

 ESP_SR.setMode(SR_MODE_COMMAND);
 }

 break;

 case SR_EVENT_COMMAND:

 if (
 !soundMode &&
 !commandCooldownActive()
 ) {

 detectedVoiceCommand = command_id;
 }

 ESP_SR.setMode(SR_MODE_COMMAND);

 break;

 case SR_EVENT_TIMEOUT:

 timeoutDetected = true;

 ESP_SR.setMode(SR_MODE_WAKEWORD);

 break;

 default:
 break;
 }
}

// =====================================================
// VOICE COMMAND HANDLER
// =====================================================

void handleVoiceCommand(int command) {

 if (commandCooldownActive()) return;

 switch (command) {

 case CMD_PLAY:

 performAction(
 ACTION_PLAY_PAUSE,
 "VOICE"
 );

 break;

 case CMD_PAUSE:

 performAction(
 ACTION_PLAY_PAUSE,
 "VOICE"
 );

 break;

 case CMD_NEXT:

 performAction(
 ACTION_NEXT,
 "VOICE"
 );

 break;

 case CMD_PREVIOUS:

 performAction(
 ACTION_PREVIOUS,
 "VOICE"
 );

 break;

 case CMD_VOLUME_UP:

 performAction(
 ACTION_VOLUME_UP,
 "VOICE"
 );

 break;

 case CMD_VOLUME_DOWN:

 performAction(
 ACTION_VOLUME_DOWN,
 "VOICE"
 );

 break;

 case CMD_MUTE:

 performAction(
 ACTION_MUTE,
 "VOICE"
 );

 break;

 default:

 Serial.print("Unknown voice command: ");
 Serial.println(command);

 break;
 }
}

// =====================================================
// VOICE SETUP
// =====================================================

void setupVoice() {

 Serial.println();
 Serial.println("Starting microphone...");

 i2s.setTimeout(1000);

 i2s.setPins(
 MIC_BCLK,
 MIC_WS,
 -1,
 MIC_DOUT
 );

 if (
 !i2s.begin(
 I2S_MODE_STD,
 SR_SAMPLE_RATE,
 I2S_DATA_BIT_WIDTH_32BIT,
 I2S_CHANNELS,
 I2S_STD_SLOT_LEFT
 )
 ) {

 Serial.println(
 "ERROR: I2S microphone failed."
 );

 return;
 }

 if (
 !i2s.configureRX(
 SR_SAMPLE_RATE,
 I2S_DATA_BIT_WIDTH_32BIT,
 I2S_CHANNELS,
 I2S_RX_TRANSFORM_32_TO_16
 )
 ) {

 Serial.println(
 "ERROR: I2S conversion failed."
 );

 i2s.end();

 return;
 }

 Serial.println("Microphone ready.");

 ESP_SR.onEvent(onSrEvent);

 Serial.println("Starting ESP-SR...");

 bool srStarted =
 ESP_SR.begin(
 i2s,
 srCommands,
 sizeof(srCommands) / sizeof(sr_cmd_t),
 SR_INPUT_CHANNELS,
 SR_MODE_WAKEWORD,
 SR_INPUT_FORMAT
 );

 if (!srStarted) {

 Serial.println("ERROR: ESP-SR failed.");

 return;
 }

 voiceReady = true;

 Serial.println();
 Serial.println("ESP-SR VOICE READY");

 Serial.println("Say: Hi ESP");
}

